FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1.0;

vertices
(
    // ----------------------------------------------------------------------
    // Bottom plane: Z = -500 um
    // ----------------------------------------------------------------------

    (0          0          -500e-6)     // 0
    (1500e-6    0          -500e-6)     // 1
    (1500e-6    1500e-6    -500e-6)     // 2
    (0          1500e-6    -500e-6)     // 3


    // ----------------------------------------------------------------------
    // Internal interface: Z = 0
    // ----------------------------------------------------------------------

    (0          0           0)           // 4
    (1500e-6    0           0)           // 5
    (1500e-6    1500e-6     0)           // 6
    (0          1500e-6     0)           // 7


    // ----------------------------------------------------------------------
    // Top plane: Z = 300 um
    // ----------------------------------------------------------------------

    (0          0           300e-6)      // 8
    (1500e-6    0           300e-6)      // 9
    (1500e-6    1500e-6     300e-6)      // 10
    (0          1500e-6     300e-6)      // 11
);


blocks
(
    // ----------------------------------------------------------------------
    // Block 0: deep substrate
    //
    // X: 1500 um / 300 = 5 um
    // Y: 1500 um / 300 = 5 um
    //
    // Z: -500 ~ 0 um
    // 46 cells
    //
    // simpleGrading Z = 0.25:
    // approximately 20.0 um at Z = -500 um
    // approximately  5.0 um at Z = 0
    // ----------------------------------------------------------------------

    hex (0 1 2 3 4 5 6 7)
    (300 300 46)
    simpleGrading (1 1 0.25)


    // ----------------------------------------------------------------------
    // Block 1: near-surface substrate + powder + gas
    //
    // X: 1500 um / 300 = 5 um
    // Y: 1500 um / 300 = 5 um
    // Z:  300 um / 60  = 5 um
    //
    // Fully uniform 5 x 5 x 5 um
    // ----------------------------------------------------------------------

    hex (4 5 6 7 8 9 10 11)
    (300 300 60)
    simpleGrading (1 1 1)
);


edges
(
    // No curved edges are required.
);


boundary
(
    // ======================================================================
    // X = 0
    // ======================================================================

    back
    {
        type wall;

        faces
        (
            // Deep substrate
            (0 4 7 3)

            // Upper fine region
            (4 8 11 7)
        );
    }


    // ======================================================================
    // X = 1500 um
    // ======================================================================

    front
    {
        type wall;

        faces
        (
            // Deep substrate
            (1 2 6 5)

            // Upper fine region
            (5 6 10 9)
        );
    }


    // ======================================================================
    // Y = 0
    // ======================================================================

    leftWall
    {
        type wall;

        faces
        (
            // Deep substrate
            (1 5 4 0)

            // Upper fine region
            (5 9 8 4)
        );
    }


    // ======================================================================
    // Y = 1500 um
    // ======================================================================

    rightWall
    {
        type patch;

        faces
        (
            // Deep substrate
            (3 7 6 2)

            // Upper fine region
            (7 11 10 6)
        );
    }


    // ======================================================================
    // Z = 300 um
    // ======================================================================

    topWall
    {
        type patch;

        faces
        (
            (8 9 10 11)
        );
    }


    // ======================================================================
    // Z = -500 um
    // ======================================================================

    bottomWall
    {
        type patch;

        faces
        (
            (0 3 2 1)
        );
    }
);


mergePatchPairs
(
);


