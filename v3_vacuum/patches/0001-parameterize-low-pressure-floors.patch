From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Subject: [PATCH] Parameterize low-pressure numerical guards

Baseline:
  laserbeamfoam/LaserbeamFoam
  OpenFoam_com_main
  3c93f2657e089e22e9a8298648292969e85a4bad

Purpose:
  Expose the hard-coded low-pressure numerical guards that are active for
  sub-Pa vacuum verification while preserving upstream default behaviour.

  This patch deliberately does NOT change the Clausius-Clapeyron /
  Hertz-Knudsen phase-change law and does NOT add an empirical recoil term.

---
 applications/solvers/compressibleLaserbeamFoam/multiphaseMixtureThermo/multiphaseMixtureThermo.C | 55 ++++++++++++++++++++++++++++++++-----
 applications/solvers/compressibleLaserbeamFoam/setDeltaT_.H                                      |  5 +++-
 2 files changed, 52 insertions(+), 8 deletions(-)

diff --git a/applications/solvers/compressibleLaserbeamFoam/multiphaseMixtureThermo/multiphaseMixtureThermo.C b/applications/solvers/compressibleLaserbeamFoam/multiphaseMixtureThermo/multiphaseMixtureThermo.C
--- a/applications/solvers/compressibleLaserbeamFoam/multiphaseMixtureThermo/multiphaseMixtureThermo.C
+++ b/applications/solvers/compressibleLaserbeamFoam/multiphaseMixtureThermo/multiphaseMixtureThermo.C
@@ -145,6 +145,20 @@ Foam::multiphaseMixtureThermo::multiphaseMixtureThermo
     alphas_.write();
     correct();                  // therm    o (phase densities) are valid after this
 
+    Info<< "Low-pressure numerical controls:" << nl
+        << "    rhoMinEOS                  = "
+        << lookupOrDefault<scalar>("rhoMinEOS", 1e-3) << " kg/m3" << nl
+        << "    pSmallSat                  = "
+        << lookupOrDefault<scalar>("pSmallSat", 1.0) << " Pa" << nl
+        << "    phaseChangeRhoFloor        = "
+        << lookupOrDefault<scalar>("phaseChangeRhoFloor", 0.01) << " kg/m3" << nl
+        << "    partialMassRhoFloor        = "
+        << lookupOrDefault<scalar>("partialMassRhoFloor", 1e-3) << " kg/m3" << nl
+        << "    recoveryRhoFloor           = "
+        << lookupOrDefault<scalar>("recoveryRhoFloor", 1e-3) << " kg/m3" << nl
+        << "    implicitCouplingPressureFloor = "
+        << lookupOrDefault<scalar>("implicitCouplingPressureFloor", 1e4) << " Pa"
+        << endl;
+
          c_.setSize(phases_.size());
     c0_.setSize(phases_.size());
 
@@ -407,12 +421,17 @@ void Foam::multiphaseMixtureThermo::correctRho(const volScalarField& dp)
 {
+    const scalar rhoMinEOSValue
+    (
+        lookupOrDefault<scalar>("rhoMinEOS", 1e-3)
+    );
+
     for (phaseModel& phase : phases_)
     {
         volScalarField& rhoPh = phase.thermo().rho();
         rhoPh += phase.thermo().psi()*dp;
         // was 1e-4.. 1/rho feeds the p matrix coefficients and the extra
         // decade of conditioning bought nothing, match the other floors
-        rhoPh = max(rhoPh, dimensionedScalar("rhoMinEOS", dimDensity, 1e-3));
+        rhoPh = max
+        (
+            rhoPh,
+            dimensionedScalar("rhoMinEOS", dimDensity, rhoMinEOSValue)
+        );
     }
 }
 
@@ -1959,7 +1978,14 @@ Foam::tmp<Foam::volScalarField> Foam::multiphaseMixtureThermo::solveAlphas
                                 (
                                     p_,
                                     dimensionedScalar
-                                    ("pSmallSat", P0.dimensions(), 1.0)
+                                    (
+                                        "pSmallSat",
+                                        P0.dimensions(),
+                                        phasedictionary.getOrDefault<scalar>
+                                        (
+                                            "pSmallSat",
+                                            1.0
+                                        )
+                                    )
                                 )
                                /(
                                     max
@@ -2366,7 +2392,14 @@ Foam::tmp<Foam::volScalarField> Foam::multiphaseMixtureThermo::solveAlphas
     );
 
     {
-        const dimensionedScalar rhoFloorY("rhoFloorY", dimDensity, 1e-3);
+        const dimensionedScalar rhoFloorY
+        (
+            "rhoFloorY",
+            dimDensity,
+            phasedictionary.getOrDefault<scalar>
+            (
+                "partialMassRhoFloor",
+                1e-3
+            )
+        );
         label i = 0;
         for (phaseModel& ph : phases_)
         {
@@ -2785,7 +2818,14 @@ Foam::tmp<Foam::volScalarField> Foam::multiphaseMixtureThermo::solveAlphas
             //  densities at the current p and T, and they never quite do (species move
             //  once per step with last steps fluxes while p moves by bars at the spot)
                 //  so a defect builds every step.....
 
-    const dimensionedScalar rhoMinRec("rhoMinRec", dimDensity, 1e-3);
+    const dimensionedScalar rhoMinRec
+    (
+        "rhoMinRec",
+        dimDensity,
+        phasedictionary.getOrDefault<scalar>
+        (
+            "recoveryRhoFloor",
+            1e-3
+        )
+    );
 
     // closure trust
     //   closureGasFracMin: the gas mass-balance must explain at least this
@@ -3032,6 +3072,11 @@ Foam::tmp<Foam::volScalarField> Foam::multiphaseMixtureThermo::solveAlphas
     if (vDotPptr)
     {
         const scalar implicitVolLimit =
             phasedictionary.getOrDefault<scalar>("implicitVolLimit", 0.2);
+        const scalar implicitCouplingPressureFloor =
+            phasedictionary.getOrDefault<scalar>
+            (
+                "implicitCouplingPressureFloor", 1e4
+            );
 
         scalarField& vpI = vDotPptr->primitiveFieldRef();
         const scalarField& pI = p_.primitiveField();
@@ -3042,7 +3087,11 @@ Foam::tmp<Foam::volScalarField> Foam::multiphaseMixtureThermo::solveAlphas
         forAll(vpI, celli)
         {
             const scalar kPmax =
-                implicitVolLimit*rDeltaT/Foam::max(pI[celli], scalar(1e4));
+                implicitVolLimit*rDeltaT
+               /Foam::max
+                (
+                    pI[celli],
+                    implicitCouplingPressureFloor
+                );
             if (vpI[celli] > kPmax)
             {
                 vpI[celli] = kPmax;
diff --git a/applications/solvers/compressibleLaserbeamFoam/setDeltaT_.H b/applications/solvers/compressibleLaserbeamFoam/setDeltaT_.H
--- a/applications/solvers/compressibleLaserbeamFoam/setDeltaT_.H
+++ b/applications/solvers/compressibleLaserbeamFoam/setDeltaT_.H
@@ -14,8 +14,11 @@ if (adjustTimeStep)
 
     scalar acousticCoNum = 0.0;
     {
-        const volScalarField pSafe(max(p, dimensionedScalar(dimPressure, 1e4)));
-const volScalarField c
+        const scalar acousticPressureFloor =
+            runTime.controlDict().getOrDefault<scalar>
+            ("acousticPressureFloor", 1e4);
+        const volScalarField pSafe
+            (max(p, dimensionedScalar(dimPressure, acousticPressureFloor)));
+        const volScalarField c
 (
     sqrt(max(mixture.gamma()*pSafe/max(mixture.rho(), dimensionedScalar(dimDensity, SMALL)),
              dimensionedScalar(sqr(dimVelocity), Zero)))
-- 
2.43.0
