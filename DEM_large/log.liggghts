LIGGGHTS (Version LIGGGHTS-PFM 24.01, compiled 2025-09-01-20:54:06 by kris, git commit d075b97762ce4302707903718dda170920e630bd, based on LAMMPS 23 Nov 2013)
# Trial run of Powder loading

atom_style		granular
atom_modify		map	array
boundary		m	m	m
newton			off

communicate		single vel yes

units 			cgs

region			domain block 0.0 0.03 0.0 0.15 0.0 0.05 units box

create_box		1 domain
Created orthogonal box = (0 0 0) to (0.03 0.15 0.05)
  1 by 1 by 1 MPI processor grid

neighbor		0.008101 bin
neigh_modify	delay 0

### Setup

# Material and Interaction Properties
fix 		m1 all property/global youngsModulus peratomtype 5e7
fix 		m2 all property/global poissonsRatio peratomtype 0.30
fix 		m3 all property/global coefficientRestitution peratomtypepair 1 0.10
fix 		m4 all property/global coefficientFriction peratomtypepair 1 0.10

# New pair style
pair_style gran model hertz tangential history #Hertzian without cohesion
pair_coeff	* *

# Integrator
fix			integrate all nve/sphere

# Time step
timestep	0.00000005

# Gravity
fix		grav all gravity 981 vector 0.0 0.0 -1.0

# -------------------------------------------------------------------------
# Particle insertion
# M247 powder, D = 30-80 um
# In cgs:
#   1 um = 1e-4 cm
#   radius[cm] = D[um]/2*1e-4
# Density:
#   8.54e3 kg/m3 = 8.54 g/cm3
# -------------------------------------------------------------------------

fix pts1  all particletemplate/sphere 15485863 atom_type 1 density constant 8.54 radius constant 0.001625
fix pts2  all particletemplate/sphere 154849   atom_type 1 density constant 8.54 radius constant 0.001875
fix pts3  all particletemplate/sphere 49979687 atom_type 1 density constant 8.54 radius constant 0.002125
fix pts4  all particletemplate/sphere 15485867 atom_type 1 density constant 8.54 radius constant 0.002375
fix pts5  all particletemplate/sphere 32452843 atom_type 1 density constant 8.54 radius constant 0.002625
fix pts6  all particletemplate/sphere 32452867 atom_type 1 density constant 8.54 radius constant 0.002875
fix pts7  all particletemplate/sphere 67867979 atom_type 1 density constant 8.54 radius constant 0.003125
fix pts8  all particletemplate/sphere 86028121 atom_type 1 density constant 8.54 radius constant 0.003375
fix pts9  all particletemplate/sphere 16193    atom_type 1 density constant 8.54 radius constant 0.003625
fix pts10 all particletemplate/sphere 17167    atom_type 1 density constant 8.54 radius constant 0.003875

# Discrete PSD fitted from D10=36.5, D50=52.6, D90=74.4 um
# Weights sum to 1.0.
fix pdd all particledistribution/discrete 78593 10     pts1  0.05440792     pts2  0.09955866     pts3  0.13695588     pts4  0.15386793     pts5  0.14919514     pts6  0.12968947     pts7  0.10382025     pts8  0.07804724     pts9  0.05589838     pts10 0.03855913

# Insert particles from above the powder bed.
region 	factory block 0.0 0.03 0.0 0.15 0.02 0.05 units box
fix ins all insert/rate/region seed 51869 distributiontemplate pdd 	nparticles 1250 particlerate 200000 insert_every 1000 	overlapcheck yes vel constant 0. 0. 0.0 region factory ntry_mc 10000


# Boundary
fix box all mesh/surface file meshes/domain.stl type 1 scale 0.1 curvature 1e-5
fix plate all mesh/surface file meshes/plate.stl type 1 scale 0.1 curvature 1e-5
fix wall all wall/gran model hertz tangential history mesh n_meshes 2  meshes box plate

variable x1 atom x*0.01
variable y1 atom y*0.01
variable z1 atom z*0.01


compute 1 all property/atom radius
variable rad1 atom "c_1*0.01"

# Check time step and initialize dump file
#fix ctg all check/timestep/gran 1 0.01 0.01
run 1
INFO: Particle insertion ins: 10.000000 particles every 1000 steps - particle rate 200000.000000, (mass rate 0.096013)
